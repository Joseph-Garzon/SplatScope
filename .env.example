# Discord bot credentials (Discord Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this while developing so slash commands register instantly to one server
# instead of taking up to an hour to propagate globally. Leave blank for production.
DISCORD_DEV_GUILD_ID=

# start.gg personal access token (start.gg/admin/profile/developer)
STARTGG_API_TOKEN=

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/splatscope.sqlite
