# Discord bot credentials (Discord Developer Portal > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set this while developing so slash commands register instantly to
# one or more servers instead of taking up to an hour to propagate globally.
# Comma-separated for multiple test servers, e.g. 123456789012345678,987654321098765432
# Leave blank for production.
DISCORD_DEV_GUILD_ID=

# start.gg personal access token (start.gg/admin/profile/developer)
STARTGG_API_TOKEN=

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/splatscope.sqlite
